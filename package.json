{
	"name": "pow-reaction",
	"version": "1.0.19",
	"type": "module",
	"author": "Viktor Shchelochkov <hi@hloth.dev> (https://hloth.dev)",
	"description": "proof-of-work reactions for your blogs",
	"license": "MIT",
	"funding": "https://hloth.dev/donate",
	"support": {
		"backing": {
			"npm-funding": true
		}
	},
	"keywords": [
		"svelte",
		"svelte-component",
		"pow",
		"proof-of-work",
		"blog-component"
	],
	"repository": {
		"type": "git",
		"url": "git+https://git.hloth.dev/hloth/pow-reaction.git"
	},
	"bugs": {
		"url": "https://git.hloth.dev/hloth/pow-reaction/issues"
	},
	"homepage": "https://git.hloth.dev/hloth/pow-reaction#readme",
	"scripts": {
		"dev": "vite dev",
		"build": "rm -rf dist && vite build && bun run prepack",
		"preview": "bun run build && wrangler pages dev",
		"prepare": "svelte-kit sync || echo ''",
		"prepack": "svelte-kit sync && svelte-package && publint",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"format": "prettier --write .",
		"lint": "prettier --check . && eslint .",
		"deploy": "bun run build && wrangler pages deploy",
		"cf-typegen": "wrangler types src/worker-configuration.d.ts"
	},
	"publishConfig": {
		"access": "public"
	},
	"files": [
		"dist",
		"!dist/**/*.test.*",
		"!dist/**/*.spec.*"
	],
	"sideEffects": [
		"**/*.css"
	],
	"svelte": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"svelte": "./dist/index.js",
			"import": "./dist/index.js"
		}
	},
	"imports": {
		"#lib": "./src/lib/index.js",
		"#lib/*": "./src/lib/*"
	},
	"peerDependencies": {
		"svelte": "^5.39.8"
	},
	"devDependencies": {
		"@eslint/js": "^10.0.1",
		"@sveltejs/adapter-cloudflare": "^8.0.2",
		"@sveltejs/kit": "^3.1.1",
		"@sveltejs/package": "^3.0.2",
		"@sveltejs/vite-plugin-svelte": "^7.3.1",
		"@tailwindcss/vite": "^4.3.4",
		"eslint": "^10.14.0",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-svelte": "^3.24.0",
		"globals": "^17.14.0",
		"prettier": "^3.9.10",
		"prettier-plugin-svelte": "^3.4.0",
		"publint": "^0.3.25",
		"svelte": "^5.57.3",
		"svelte-check": "^4.7.8",
		"tailwindcss": "^4.3.4",
		"typescript": "^6.0.3",
		"typescript-eslint": "^8.72.1",
		"vite": "^8.3.5",
		"wrangler": "^4.157.0"
	},
	"dependencies": {
		"@noble/hashes": "^2.4.0",
		"@oslojs/jwt": "^0.3.0",
		"esm-env": "^1.2.2",
		"zod": "^4.6.7"
	}
}